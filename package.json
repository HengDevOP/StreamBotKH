{
  "name": "streambotkh",
  "version": "1.0.0",
  "description": "streambotkh.com - Livestream Donation Alerts & ABA Bakong KHQR Engine (Vite + React TSX + Express)",
  "scripts": {
    "dev": "concurrently --names \"API,VITE\" --prefix-colors \"magenta,cyan\" \"PORT=5001 tsx server/index.ts\" \"vite --host 0.0.0.0 --port 3000\"",
    "build": "vite build",
    "start": "NODE_ENV=production PORT=3000 tsx server/index.ts",
    "backend": "tsx backend/src/index.ts",
    "start:all": "concurrently --names \"APP,TELEGRAM\" --prefix-colors \"cyan,magenta\" \"npm run start\" \"npm run backend\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongodb": "^7.7.0",
    "multer": "^2.5.0",
    "next": "14.2.24",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "telegram": "^2.26.22",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}

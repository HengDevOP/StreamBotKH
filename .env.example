PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Telegram Integration (TelegramJS MTProto & Bot)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=YourBotUsername

# MongoDB Database Connection (MongoDB Atlas Cloud Cluster or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/streambotkh?retryWrites=true&w=majority

# NOTE: ABA PayWay merchant credentials (Merchant ID & API Key) are configured
# per-streamer directly inside the Dashboard → Payment Gateway (Pro plan only).
# No global ABA credentials are needed here.

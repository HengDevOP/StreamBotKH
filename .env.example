# ============================================================================
# STREAMBOTKH PLATFORM — SAMPLE ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to `.env` and fill in your credentials.
# ============================================================================

# 1. Core Application & Security Secrets
PORT=5173
NEXT_PUBLIC_APP_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_signing_key_here
PAYMENT_SIMULATION_SECRET=sim_sec_your_simulation_secret
PAYMENT_GATEWAY_SECRET=gw_sec_your_gateway_secret

# 2. Google OAuth 2.0 Authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# 3. Telegram Integration (TelegramJS MTProto & Bot Listener)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=StreamNeonAlertBot

# 4. MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/streamneon
MONGODB_DB=streamneon

# 5. Nodemailer SMTP Email Configuration (Account Deletion & Security Alerts)
# For Gmail: use smtp.gmail.com, port 587 (SMTP_SECURE=false) or 465 (SMTP_SECURE=true)
# and generate a 16-character Google App Password for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME=StreamBotKH Security
SMTP_FROM_EMAIL=your_email@gmail.com
